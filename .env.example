# 复制成 .env 再改：cp .env.example .env

# 面板登录密码（必填）
GROK_HUB_PASSWORD=改成你的密码

# 注册机出网代理。宿主机上的代理必须用 docker 网桥地址 172.17.0.1，
# 写 127.0.0.1 会指向容器自己。留空则容器直连（多数情况下访问不了 x.ai）。
REGISTER_PROXY=http://172.17.0.1:7890   # 构建和运行都会用到

# 面板端口（宿主侧）
GROK_HUB_PORT=8790

# 前面有 HTTPS 反代时设 1，让登录 cookie 带 Secure
GROK_HUB_TLS=0

# 内存上限。注册机开 Chromium 比较吃内存，小机器别调太低
MEM_LIMIT=2g

# 想用注册机的其他分支或自己的 fork
# REGISTER_REPO=https://github.com/hechuyi/grok-free-register.git
# REGISTER_REF=main
